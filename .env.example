# Copy to .env.local and fill in. Never commit real values.
# The ticket that needs each variable is noted in brackets.

# Convex (hosted). `npx convex dev` writes these three for you. [S0, all data tickets]
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Better Auth (staff login). [S0, E3]
# These two are set on the Convex deployment, not in .env.local:
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set SITE_URL http://localhost:3000
BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000

# Email sender for staff sign-in codes. In development codes are logged instead. [E3]
EMAIL_FROM=
EMAIL_API_KEY=

# Transcription server running Parakeet. Build against a stub until it exists. [A3]
PARAKEET_URL=
PARAKEET_TOKEN=

# Model API key for the listener and the blueprint builder. [A3, A4]
ANTHROPIC_API_KEY=

# Stripe, test mode only. [E2]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
