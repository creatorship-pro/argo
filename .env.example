# Copy to .env.local and fill in. Never commit real values.
# The ticket that needs each variable is noted in brackets.
#
# Two places hold settings:
#   .env.local (or the env file on the server)  read by the Next.js app
#   the Convex deployment (`npx convex env set NAME value`)  read by Convex functions

# --- Next.js app (.env.local / server env file) -----------------------------

# Convex (hosted). `npx convex dev` writes these three for you. [S0, all data tickets]
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# The app's public address (https on the server). Used for the Stripe return link. [E2, S7]
SITE_URL=http://localhost:3000

# Transcription server running Parakeet. Build against a stub until it exists.
# The contract is in docs/parakeet-contract.md. [A3]
PARAKEET_URL=
PARAKEET_TOKEN=

# Stripe, test mode only: the app refuses a live key unless STRIPE_ALLOW_LIVE=1. [E2]
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional. Stripe Tax needs your tax settings first. Terms checkbox needs a terms URL in the Stripe dashboard.
# STRIPE_TAX=1
# STRIPE_REQUIRE_TERMS=0

# --- Convex deployment (npx convex env set ...) -------------------------------

# Better Auth (staff login). [S0, E3]
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set SITE_URL http://localhost:3000
BETTER_AUTH_SECRET=

# Who may sign in, and as what: email:role, comma separated. Roles: fde, facilitator, admin. [E3]
# A bare email counts as fde. Codes are only ever sent to these addresses.
STAFF_ALLOWLIST=

# Email sender for staff sign-in codes. In development codes are logged to the Convex log instead. [E3]
# The sender uses Resend's HTTP API; swap src/lib/access/sign-in-code.ts for another provider.
EMAIL_FROM=
EMAIL_API_KEY=

# Model for the listener and the blueprint builder. Without a key, suggestions are a plain
# checklist and designs are a labeled stand-in. ARGO_MODEL defaults to claude-sonnet-5. [A3, A4]
ANTHROPIC_API_KEY=
# ARGO_MODEL=
# Rehearsal only: lets designs use capabilities that are still unreviewed drafts. Leave unset for the event. [A4, B1]
# ARGO_ALLOW_UNVETTED=1

# Stripe webhook signing secret. Endpoint: <NEXT_PUBLIC_CONVEX_SITE_URL>/stripe/webhook [E2]
STRIPE_WEBHOOK_SECRET=
